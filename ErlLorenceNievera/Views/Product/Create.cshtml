@model Nievera_ErlLorenceAPI.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<h1>Add Product</h1>

<hr />

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">
            Product Name
        </label>

        <input asp-for="Name"
               class="form-control"
               placeholder="Enter product name" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label">
            Price
        </label>

        <input asp-for="Price"
               type="number"
               step="0.01"
               min="0.01"
               class="form-control"
               placeholder="Enter price" />

        <span asp-validation-for="Price"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Stock" class="form-label">
            Stock
        </label>

        <input asp-for="Stock"
               type="number"
               min="0"
               class="form-control"
               placeholder="Enter stock quantity" />

        <span asp-validation-for="Stock"
              class="text-danger">
        </span>
    </div>

    <button type="submit"
            class="btn btn-success">
        Save Product
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
