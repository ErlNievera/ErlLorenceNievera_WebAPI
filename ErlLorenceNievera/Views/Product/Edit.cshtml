@model Nievera_ErlLorenceAPI.Models.Product

<h1>Edit Product</h1>

<form asp-action="Edit" method="post">

    <input type="hidden"
           asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">
            Product Name
        </label>

        <input asp-for="Name"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Price
        </label>

        <input asp-for="Price"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Stock
        </label>

        <input asp-for="Stock"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Update Product
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
