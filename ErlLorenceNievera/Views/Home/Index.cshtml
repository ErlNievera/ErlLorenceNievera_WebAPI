@{
ViewData["Title"] = "Product Management";
}

<div class="container py-5">
<div class="row align-items-center">

    <div class="col-lg-7">

        <span class="badge bg-primary mb-3">
            PRODUCT MANAGEMENT SYSTEM
        </span>

        <h1 class="display-4 fw-bold mb-3">
            Manage your products with ease.
        </h1>

        <p class="lead text-muted mb-4">
            Add, edit, search, and manage your products
            through a simple and user-friendly interface.
        </p>

        <div class="d-flex gap-2">

            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-primary btn-lg">
                <i class="bi bi-box-seam"></i>
                View Products
            </a>

            <a asp-controller="Product"
               asp-action="Create"
               class="btn btn-outline-primary btn-lg">
                <i class="bi bi-plus-lg"></i>
                Add Product
            </a>

        </div>

    </div>

    <div class="col-lg-5 mt-5 mt-lg-0">

        <div class="card border-0 shadow-lg">
            <div class="card-body p-5 text-center">

                <div class="mb-4">
                    <i class="bi bi-box-seam text-primary"
                       style="font-size: 5rem;">
                    </i>
                </div>

                <h3 class="fw-bold">
                    Product Management
                </h3>

                <p class="text-muted">
                    Keep your product inventory organized
                    and up to date.
                </p>

                <div class="row mt-4">

                    <div class="col-4">
                        <h4 class="fw-bold text-primary">CRUD</h4>
                        <small class="text-muted">
                            Operations
                        </small>
                    </div>

                    <div class="col-4">
                        <h4 class="fw-bold text-primary">API</h4>
                        <small class="text-muted">
                            Connected
                        </small>
                    </div>

                    <div class="col-4">
                        <h4 class="fw-bold text-primary">MVC</h4>
                        <small class="text-muted">
                            Interface
                        </small>
                    </div>

                </div>

            </div>
        </div>

    </div>

</div>

</div>